{
  "version": 2,
  "builds": [
    {
      "src": "job_site/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "**",
          "db.sqlite3"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "job_site/wsgi.py"
    }
  ]
}
